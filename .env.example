TELEGRAM_BOT_TOKEN=
# 私密来源频道的数字 ID，格式通常为 -100xxxxxxxxxx。
TELEGRAM_SOURCE_CHAT_ID=
# 执行回报目标；暂不启用发送时可以留空。
TELEGRAM_REPORT_CHAT_ID=
# 同一 .env 可同时保存模拟盘与实盘凭据；程序严格按 config.yaml 的 mode 读取对应一组。
# OKX: DEMO / LIVE
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_API_PASSPHRASE=
# Binance: TESTNET / LIVE
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
# Gate: TESTNET / LIVE
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=
GATE_LIVE_API_KEY=
GATE_LIVE_API_SECRET=
# 必须明确设置为 true，非模拟模式才允许启动。
ALLOW_LIVE_TRADING=false
