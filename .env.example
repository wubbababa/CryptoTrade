TELEGRAM_BOT_TOKEN=
# 私密来源频道的数字 ID，格式通常为 -100xxxxxxxxxx。
TELEGRAM_SOURCE_CHAT_ID=
# 执行回报目标；暂不启用发送时可以留空。
TELEGRAM_REPORT_CHAT_ID=
# OKX DEMO 模式必须填写模拟盘创建的 Key，LIVE 模式填写实盘 Key。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Binance TESTNET 与 LIVE 的 Key 不通用。
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Gate TESTNET 与 LIVE 的 Key 不通用。
GATE_API_KEY=
GATE_API_SECRET=
# 必须明确设置为 true，非模拟模式才允许启动。
ALLOW_LIVE_TRADING=false
